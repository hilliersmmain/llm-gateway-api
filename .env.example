# Gemini Guardrails API Environment Variables

# Required: Your Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_GOES_HERE
# Database connection URL
DATABASE_URL=postgresql+asyncpg://user:change_me@db:5432/llm_gateway

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
ENVIRONMENT=development

# API authentication (set PROTECTED_PATHS=true for production)
PROTECTED_PATHS=false
API_KEY=change_me
ADMIN_API_KEY=change_me_admin

# API surface exposure
ENABLE_DOCS=true
ENABLE_OPENAPI=true
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Request safety
MAX_REQUEST_BODY_BYTES=65536

# Gemini runtime behavior
MODEL_NAME=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_ATTEMPTS=2

# Guardrails
MAX_INPUT_LENGTH=5000
BLOCKED_KEYWORDS=["secret_key","internal_only"]

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=

# Logging privacy and retention
LOG_RAW_CONTENT=false
HASH_SALT=change_me_salt
LOG_RETENTION_DAYS=30

# Cost estimation
GEMINI_INPUT_PRICE_PER_MILLION=0.15
GEMINI_OUTPUT_PRICE_PER_MILLION=0.60
